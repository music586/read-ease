{
  "manifest_version": 3,
  "name": "ReadEase",
  "description": "将新闻和博客文章转换为安静、可定制的阅读视图。",
  "version": "0.1.0",
  "permissions": ["activeTab", "storage", "scripting", "commands"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "切换 ReadEase 阅读模式",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "toggle-reader": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "MacCtrl+Shift+R"
      },
      "description": "切换阅读模式"
    }
  }
}

